# Don't run dependency lifecycle scripts (preinstall / install / postinstall, etc.)
# to reduce supply-chain attack surface. In this project only core-js (a cosmetic
# funding message) and fsevents (a macOS-only dev file-watcher) use install
# scripts, so disabling them doesn't affect the build or CI.
#
# Tip: audit which dependencies run install scripts with:
#   npx can-i-ignore-scripts
# Re-run it after dependency bumps to review any newly added scripts.
ignore-scripts=true
